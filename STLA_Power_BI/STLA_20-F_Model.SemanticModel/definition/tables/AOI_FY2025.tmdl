			VAR _raw = CALCULATE ( SELECTEDVALUE ( 'AOI_FY2025'[STELLANTIS] ), ALL ( 'AOI_FY2025' ), 'AOI_FY2025'[Index] = 18 )
			VAR _c1  = SUBSTITUTE ( _raw, ",", "" )
