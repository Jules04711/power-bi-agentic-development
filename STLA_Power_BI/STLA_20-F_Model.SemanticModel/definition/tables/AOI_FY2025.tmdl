	/// AOI = Operating Income + Total Adjustments (line 21).
	measure 'Adjusted Operating Income' =
			VAR _raw = CALCULATE ( SELECTEDVALUE ( 'AOI_FY2025'[STELLANTIS] ), ALL ( 'AOI_FY2025' ), 'AOI_FY2025'[Index] = 21 )
