	/// Sum of charges considered largely non-recurring in 2026+ (Takata, hydrogen exit, Turkiye disposal, battery JV writedowns, CAFE).
	measure 'One-Time Charges - Non-Recurring' = [Takata Airbags Recall] + [Hydrogen Fuel Cell Discontinuation] + [Stellantis Turkiye Disposal] + [Battery JV Charges] + [CAFE Penalty Rate Charge]
		formatString: #,0;(#,0);—
		displayFolder: 5. Adjustment Bridge
		lineageTag: 1ccac732-3934-4622-b59d-4fd7037160d0

	/// Sum of strategic-realignment charges tied to 2030 product/platform reset (platform impairments + product plan cancellations + other impairments).
	measure 'Strategic Realignment Charges' = [Platform Impairments] + [Product Plan Realignment & Cancellations] + [Other Impairments]
		formatString: #,0;(#,0);—
		displayFolder: 5. Adjustment Bridge
		lineageTag: 79bf158d-5d73-47a3-a38a-073beb099594

	/// Stellantis Value Creation Program: 6,000 EUR M annual cost run-rate by 2028 vs 2025 baseline (per FaSTLAne 2030 strategy, May 2026).
	measure 'VCP Cost Save Target 2028' = 6000
		formatString: #,0;(#,0);—
		displayFolder: 6. FaSTLAne 2030 Targets
		lineageTag: 203647f4-7219-4ecd-a091-13d310228a5d

	/// Top-line ambition: 190,000 EUR M by 2030 (vs 153,508 in 2025).
	measure '2030 Revenue Target' = 190000
		formatString: #,0;(#,0);—
		displayFolder: 6. FaSTLAne 2030 Targets
		lineageTag: 91623f68-dd6e-4170-9577-a1ffb67e8135

	/// 7% AOI margin target by 2030.
	measure '2030 AOI Margin Target %' = 0.07
		formatString: 0.0%;(0.0%);—
		displayFolder: 6. FaSTLAne 2030 Targets
		lineageTag: 4a74386e-e98f-4c3c-b254-55e281722c36

	/// 7% of the 2030 revenue target = 13,300 EUR M.
	measure '2030 AOI Target' = [2030 Revenue Target] * [2030 AOI Margin Target %]
		formatString: #,0;(#,0);—
		displayFolder: 6. FaSTLAne 2030 Targets
		lineageTag: 1fe7289e-77cd-4951-8388-4a40d41b4b26

	/// Hypothetical: FY2025 AOI lifted by the full 6B VCP run-rate. Illustrative only - VCP achieves run-rate by 2028.
	measure 'AOI After VCP Save (FY2025 Pro-Forma)' = [Adjusted Operating Income] + [VCP Cost Save Target 2028]
		formatString: #,0;(#,0);—
		displayFolder: 6. FaSTLAne 2030 Targets
		lineageTag: 0e59897c-641f-4810-992f-aacfec44409d

	/// Pro-forma AOI margin assuming full 6B VCP captured on FY2025 revenue base.
	measure 'AOI Margin % After VCP Save' = DIVIDE ( [AOI After VCP Save (FY2025 Pro-Forma)], [Net Revenues] )
		formatString: 0.0%;(0.0%);—
		displayFolder: 6. FaSTLAne 2030 Targets
		lineageTag: c9195bd3-8dce-4f63-8377-3d5fa5cd621b

	/// Distance between FY2025 AOI and the 2030 AOI target. Positive number = improvement still required.
	measure 'Gap to 2030 AOI Target' = [2030 AOI Target] - [Adjusted Operating Income]
		formatString: #,0;(#,0);—
		displayFolder: 6. FaSTLAne 2030 Targets
		lineageTag: 21fe205f-72ba-461c-89e1-daa2c7f4f196

	/// Share of the 2030 AOI gap that the 6B VCP cost-save alone would close (assumes no revenue or mix change).
	measure 'Gap Closed by VCP %' = DIVIDE ( [VCP Cost Save Target 2028], [Gap to 2030 AOI Target] )
		formatString: 0.0%;(0.0%);—
		displayFolder: 6. FaSTLAne 2030 Targets
		lineageTag: ffd5ea3e-88ca-4a2b-84eb-e0fc39bb44c6

	/// AOI gap remaining after applying the full 6B VCP - must come from revenue growth, mix and pricing.
	measure 'Remaining Gap After VCP' = [Gap to 2030 AOI Target] - [VCP Cost Save Target 2028]
		formatString: #,0;(#,0);—
		displayFolder: 6. FaSTLAne 2030 Targets
		lineageTag: 816cadbe-09a1-4db6-b552-023093cad0bc

	/// Linear annual improvement in AOI required to hit the 2030 target across 5 years.
	measure 'Implied Annual AOI Lift Required (2026-2030)' = DIVIDE ( [Gap to 2030 AOI Target], 5 )
		formatString: #,0;(#,0);—
		displayFolder: 6. FaSTLAne 2030 Targets
		lineageTag: 28f3bbdc-4e09-4f0e-9566-be6c1dc8beda

	/// NA share of FY2025 Stellantis net revenues.
	measure 'Revenue Share % - North America' = DIVIDE ( [Net Revenues - North America], [Net Revenues] )
		formatString: 0.0%;(0.0%);—
		displayFolder: 7. VCP Save Allocation
		lineageTag: 43f0b854-710a-445b-a7dd-1bb2410f9f86

	/// Enlarged Europe share of FY2025 Stellantis net revenues.
	measure 'Revenue Share % - Enlarged Europe' = DIVIDE ( [Net Revenues - Enlarged Europe], [Net Revenues] )
