	partition Company_Info = m
		mode: import
		source =
				let
				    Source = Json.Document(Web.Contents ("https://data.sec.gov/submissions/CIK" & CIK1 & ".json")),
				        name = Source[name],
				        cik = Source[cik],
				        entityType = Source[entityType],
				        sic = Source[sic],
				        sicDescription = Source[sicDescription],
				        Result = #table({"Name", "CIK", "Entity Type", "SIC", "SIC Description"}, {{name, cik, entityType, sic, sicDescription}})
				in
				    Result

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation

